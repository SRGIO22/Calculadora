<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvPantalla"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#BDBDBD"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:text="0"
        android:textColor="#000000"
        android:textSize="36sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:columnCount="4"
        android:rowCount="4"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/boton1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="1" />

        <Button
            android:id="@+id/boton2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="2" />

        <Button
            android:id="@+id/boton3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="3" />

        <Button
            android:id="@+id/boton_barra"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="/" />

        <Button
            android:id="@+id/boton4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="4" />

        <Button
            android:id="@+id/boton5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="5" />

        <Button
            android:id="@+id/boton6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="6" />

        <Button
            android:id="@+id/boton_asterisco"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="*" />

        <Button
            android:id="@+id/boton7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="7" />

        <Button
            android:id="@+id/boton8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="8" />

        <Button
            android:id="@+id/boton9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="9" />

        <Button
            android:id="@+id/boton_quion"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="-" />

        <Button
            android:id="@+id/boton0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="0" />

        <Button
            android:id="@+id/boton_coma"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="." />

        <Button
            android:id="@+id/boton_igual"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="=" />

        <Button
            android:id="@+id/boton_mas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:backgroundTint="#CDDC39"
            android:text="+" />

    </GridLayout>

</LinearLayout>